# Anthropic API (required) — paste the key with no quotes or spaces
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: DPLA (Digital Public Library of America) search — free key, emailed to you:
#   curl -X POST https://api.dp.la/v2/api_key/you@example.com
# DPLA_API_KEY=

# Optional but recommended on Vercel: Upstash for Redis (Vercel → Storage).
# Adding the integration sets these automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
